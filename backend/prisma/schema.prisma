// ------------------------------------
// GENERADOR Y BASE DE DATOS
// ------------------------------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------
// ENUMS (Tipos predefinidos)
// ------------------------------------
enum EstadoHabitacion {
  Disponible
  Ocupada
  Mantenimiento
}

enum EstadoReserva {
  Pendiente
  Confirmada
  CheckIn
  CheckOut
  Cancelada
}

enum EstadoFactura {
  Emitida
  Pagada
  Anulada
}

enum EstadoConsulta {
  Pendiente
  Respondida
}

enum TipoEventoHabitacion {
  Apertura
  Cierre
  Mantenimiento
}

enum Genero {
  Femenino
  Masculino
  NoBinario
  PrefieroNoDecir
  Otro
}

// ------------------------------------
// USUARIOS Y ROLES
// ------------------------------------
model Usuario {
  id                    String             @id
  nombre                String
  apellido              String?
  fechaNacimiento       DateTime?
  genero                Genero?
  telefono              String?
  direccion             String?
  provincia             String?
  estado                Boolean            @default(true)
  fechaAlta             DateTime           @default(now())
  rolId                 Int
  rol                   Rol                @relation(fields: [rolId], references: [id])
  consultasRespondidas  Consulta[]
  eventosHabitacion     HabitacionEvento[]
  reservasAdministrador Reserva[]          @relation("ReservasAdministrador")
  reservasCliente       Reserva[]          @relation("ReservasCliente")

  @@map("usuarios")
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique // Cliente, Operador, Administrador
  descripcion String?
  usuarios    Usuario[]

  @@map("roles")
}

// ------------------------------------
// ESTRUCTURA DE HABITACIONES (Refactorizado)
// ------------------------------------

// Define el nivel de confort (Estándar, Deluxe, etc.)
model Categoria {
  id              Int              @id @default(autoincrement())
  nombre          String           @unique
  descripcion     String?
  tiposHabitacion TipoHabitacion[]

  @@map("categorias")
}

// Define la capacidad y tipo de camas (Doble Queen, Triple Twin, etc.)
model Ocupacion {
  id                 Int              @id @default(autoincrement())
  nombre             String           @unique
  capacidad          Int
  descripcionCamas   String?
  tiposHabitacion    TipoHabitacion[]

  @@map("ocupaciones")
}

// El "Producto" que se vende: une Categoria y Ocupacion con un precio y nombre de marketing
model TipoHabitacion {
  id           Int              @id @default(autoincrement())
  nombre       String           // Nombre de Marketing: "Estancia Trío"
  descripcion  String?          // Descripción de Marketing
  categoriaId  Int
  categoria    Categoria        @relation(fields: [categoriaId], references: [id])
  ocupacionId  Int
  ocupacion    Ocupacion        @relation(fields: [ocupacionId], references: [id])
  tarifaBase   Decimal
  superficie   Float?
  vista        String?
  politicas    String?
  habitaciones Habitacion[]     // Las habitaciones físicas de este tipo
  imagenes     ImagenHabitacion[] // Las fotos de este tipo
  amenidades   TipoHabitacionAmenidad[] // Las comodidades de este tipo

  @@unique([categoriaId, ocupacionId, nombre]) // Evita duplicados exactos
  @@map("tipos_habitacion")
}

// Las comodidades individuales (Wi-Fi, TV, etc.)
model Amenidad {
  id              Int                      @id @default(autoincrement())
  nombre          String                   @unique
  descripcion     String?
  icono           String?
  tiposHabitacion TipoHabitacionAmenidad[]

  @@map("amenidades")
}

// Tabla de unión: Qué amenidades tiene cada TipoHabitacion
model TipoHabitacionAmenidad {
  tipoHabitacionId Int
  amenidadId       Int
  amenidad         Amenidad       @relation(fields: [amenidadId], references: [id])
  tipoHabitacion   TipoHabitacion @relation(fields: [tipoHabitacionId], references: [id])

  @@id([tipoHabitacionId, amenidadId])
  @@map("tipos_habitacion_amenidades")
}

// Las fotos asociadas a un TipoHabitacion
model ImagenHabitacion {
  id               Int            @id @default(autoincrement())
  tipoHabitacionId Int
  tipoHabitacion   TipoHabitacion @relation(fields: [tipoHabitacionId], references: [id])
  url              String
  descripcion      String?

  @@map("imagenes_habitacion")
}

// La habitación física real en el hotel
model Habitacion {
  id               Int                 @id @default(autoincrement())
  numero           String              @unique
  piso             Int
  estado           EstadoHabitacion
  tipoHabitacionId Int
  tipoHabitacion   TipoHabitacion      @relation(fields: [tipoHabitacionId], references: [id])
  eventos          HabitacionEvento[]  // Opcional para auditoría
  reservas         ReservaHabitacion[]

  @@map("habitaciones")
}

// ------------------------------------
// RESERVAS Y FACTURACIÓN
// ------------------------------------
model Reserva {
  id               Int                 @id @default(autoincrement())
  clienteId        String
  cliente          Usuario             @relation("ReservasCliente", fields: [clienteId], references: [id])
  administradorId  String?
  administrador    Usuario?            @relation("ReservasAdministrador", fields: [administradorId], references: [id])
  fechaIngreso     DateTime
  fechaEgreso      DateTime
  adultos          Int
  ninios           Int                 @default(0)
  estado           EstadoReserva
  totalAlojamiento Decimal
  totalServicios   Decimal
  totalFinal       Decimal
  creadaEn         DateTime            @default(now())
  factura          Factura?
  habitaciones     ReservaHabitacion[]
  servicios        ReservaServicio[]

  @@map("reservas")
}

// Tabla de unión: Qué habitaciones específicas se asignaron a una reserva
model ReservaHabitacion {
  id            Int        @id @default(autoincrement())
  reservaId     Int
  reserva       Reserva    @relation(fields: [reservaId], references: [id])
  habitacionId  Int
  habitacion    Habitacion @relation(fields: [habitacionId], references: [id])
  precioUnitario Decimal // Precio al momento de reservar
  subtotal      Decimal
  observaciones String?

  @@unique([reservaId, habitacionId])
  @@map("reservas_habitacion")
}

// Servicios extra (Desayuno, etc.)
model Servicio {
  id          Int               @id @default(autoincrement())
  nombre      String            @unique
  descripcion String?
  precioBase  Decimal
  estado      Boolean           @default(true)
  reservas    ReservaServicio[]

  @@map("servicios")
}

// Tabla de unión: Qué servicios extra compró un cliente en su reserva
model ReservaServicio {
  id             Int      @id @default(autoincrement())
  reservaId      Int
  reserva        Reserva  @relation(fields: [reservaId], references: [id])
  servicioId     Int
  servicio       Servicio @relation(fields: [servicioId], references: [id])
  cantidad       Int
  precioUnitario Decimal
  subtotal       Decimal
  fecha          DateTime @default(now()) // Fecha en que se añadió el servicio

  @@map("reservas_servicios")
}

model Factura {
  id            Int           @id @default(autoincrement())
  reservaId     Int           @unique
  reserva       Reserva       @relation(fields: [reservaId], references: [id])
  metodoPagoId  Int
  metodoPago    MetodoPago    @relation(fields: [metodoPagoId], references: [id])
  numeroFactura String        @unique
  fechaEmision  DateTime      @default(now())
  subtotal      Decimal
  impuestos     Decimal
  total         Decimal
  estado        EstadoFactura

  @@map("facturas")
}

model MetodoPago {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique // Efectivo, Tarjeta, Transferencia
  notas    String?
  facturas Factura[]

  @@map("metodos_pago")
}

// ------------------------------------
// COMUNICACIÓN Y AUDITORÍA
// ------------------------------------
model Consulta {
  id           Int            @id @default(autoincrement())
  nombre       String
  email        String
  asunto       String
  mensaje      String
  estado       EstadoConsulta @default(Pendiente)
  creadaEn     DateTime       @default(now())
  respondidaEn DateTime?
  respuesta    String?
  operadorId   String?
  operador     Usuario?       @relation(fields: [operadorId], references: [id])

  @@map("consultas")
}

// Opcional pero recomendado para Promoción (auditoría de habitaciones)
model HabitacionEvento {
  id            Int                  @id @default(autoincrement())
  habitacionId  Int
  habitacion    Habitacion           @relation(fields: [habitacionId], references: [id])
  adminId       String
  administrador Usuario              @relation(fields: [adminId], references: [id])
  tipo          TipoEventoHabitacion
  detalle       String?
  fecha         DateTime             @default(now())

  @@map("habitaciones_eventos")
}