// ------------------------------------
// GENERADOR Y BASE DE DATOS
// ------------------------------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------
// ENUMS (Tipos predefinidos)
// ------------------------------------
enum EstadoHabitacion {
  Disponible
  Ocupada
  Mantenimiento
}

enum EstadoReserva {
  Pendiente
  Confirmada
  CheckIn
  CheckOut
  Cancelada
}

enum EstadoFactura {
  Emitida
  Pagada
  Anulada
}

enum EstadoConsulta {
  Pendiente
  Respondida
}

enum TipoEventoHabitacion {
  Apertura
  Cierre
  Mantenimiento
}

enum Genero {
  Femenino
  Masculino
  NoBinario
  PrefieroNoDecir
  Otro
}

// ------------------------------------
// USUARIOS Y ROLES
// ------------------------------------
model Usuario {
  id                    String              @id
  nombre                String
  apellido              String?
  fechaNacimiento       DateTime?
  genero                Genero?
  telefono              String?
  direccion             String?
  provincia             String?
  estado                Boolean             @default(true)
  fechaAlta             DateTime            @default(now())
  rolId                 Int
  rol                   Rol                 @relation(fields: [rolId], references: [id])
  consultasRespondidas  Consulta[]
  eventosHabitacion     HabitacionEvento[]
  reservasAdministrador Reserva[]           @relation("ReservasAdministrador")
  reservasCliente       Reserva[]           @relation("ReservasCliente")
  bloqueosCreados       HabitacionBloqueo[] @relation("UsuarioCreadorBloqueos")
  emailsAsignados       Email[]
  emailsRespondidos     EmailRespuesta[]

  @@map("usuarios")
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique // Cliente, Operador, Administrador
  descripcion String?
  usuarios    Usuario[]

  @@map("roles")
}

// ------------------------------------
// ESTRUCTURA DE HABITACIONES (Refactorizado)
// ------------------------------------

// Define el nivel de confort (Estándar, Deluxe, etc.)
model Categoria {
  id              Int              @id @default(autoincrement())
  nombre          String           @unique
  descripcion     String?
  tiposHabitacion TipoHabitacion[]

  @@map("categorias")
}

// Define la capacidad y tipo de camas (Doble Queen, Triple Twin, etc.)
model Ocupacion {
  id               Int              @id @default(autoincrement())
  nombre           String           @unique
  capacidad        Int
  descripcionCamas String?
  tiposHabitacion  TipoHabitacion[]

  @@map("ocupaciones")
}

// El "Producto" que se vende: une Categoria y Ocupacion con un precio y nombre de marketing
model TipoHabitacion {
  id           Int                      @id @default(autoincrement())
  nombre       String // Nombre de Marketing: "Estancia Trío"
  descripcion  String? // Descripción de Marketing
  categoriaId  Int
  categoria    Categoria                @relation(fields: [categoriaId], references: [id])
  ocupacionId  Int
  ocupacion    Ocupacion                @relation(fields: [ocupacionId], references: [id])
  tarifaBase   Decimal
  superficie   Float?
  vista        String?
  politicas    String?
  habitaciones Habitacion[] // Las habitaciones físicas de este tipo
  imagenes     ImagenHabitacion[] // Las fotos de este tipo
  amenidades   TipoHabitacionAmenidad[] // Las comodidades de este tipo

  @@unique([categoriaId, ocupacionId, nombre]) // Evita duplicados exactos
  @@map("tipos_habitacion")
}

// Las comodidades individuales (Wi-Fi, TV, etc.)
model Amenidad {
  id              Int                      @id @default(autoincrement())
  nombre          String                   @unique
  descripcion     String?
  icono           String?
  tiposHabitacion TipoHabitacionAmenidad[]

  @@map("amenidades")
}

// Tabla de unión: Qué amenidades tiene cada TipoHabitacion
model TipoHabitacionAmenidad {
  tipoHabitacionId Int
  amenidadId       Int
  amenidad         Amenidad       @relation(fields: [amenidadId], references: [id])
  tipoHabitacion   TipoHabitacion @relation(fields: [tipoHabitacionId], references: [id])

  @@id([tipoHabitacionId, amenidadId])
  @@map("tipos_habitacion_amenidades")
}

// Las fotos asociadas a un TipoHabitacion
model ImagenHabitacion {
  id               Int            @id @default(autoincrement())
  tipoHabitacionId Int
  tipoHabitacion   TipoHabitacion @relation(fields: [tipoHabitacionId], references: [id])
  url              String
  descripcion      String?

  @@map("imagenes_habitacion")
}

// La habitación física real en el hotel
model Habitacion {
  id               Int                 @id @default(autoincrement())
  numero           String              @unique
  piso             Int
  estado           EstadoHabitacion
  tipoHabitacionId Int
  tipoHabitacion   TipoHabitacion      @relation(fields: [tipoHabitacionId], references: [id])
  eventos          HabitacionEvento[] // Opcional para auditoría
  reservas         ReservaHabitacion[]
  bloqueos         HabitacionBloqueo[]

  @@map("habitaciones")
}

// ------------------------------------
// RESERVAS Y FACTURACIÓN
// ------------------------------------
model Reserva {
  id               Int                 @id @default(autoincrement())
  clienteId        String
  cliente          Usuario             @relation("ReservasCliente", fields: [clienteId], references: [id])
  administradorId  String?
  administrador    Usuario?            @relation("ReservasAdministrador", fields: [administradorId], references: [id])
  fechaIngreso     DateTime
  fechaEgreso      DateTime
  adultos          Int
  ninios           Int                 @default(0)
  estado           EstadoReserva
  totalAlojamiento Decimal
  totalServicios   Decimal
  totalFinal       Decimal
  creadaEn         DateTime            @default(now())
  factura          Factura?
  contactoEmail    String?
  habitaciones     ReservaHabitacion[]
  servicios        ReservaServicio[]
  movimientos ReservaMovimiento[]

  @@map("reservas")
}

// Tabla de unión: Qué habitaciones específicas se asignaron a una reserva
model ReservaHabitacion {
  id             Int        @id @default(autoincrement())
  reservaId      Int
  reserva        Reserva    @relation(fields: [reservaId], references: [id])
  habitacionId   Int
  habitacion     Habitacion @relation(fields: [habitacionId], references: [id])
  precioUnitario Decimal // Precio al momento de reservar
  subtotal       Decimal
  observaciones  String?

  @@unique([reservaId, habitacionId])
  @@map("reservas_habitacion")
}

// Servicios extra (Desayuno, etc.)
model Servicio {
  id          Int               @id @default(autoincrement())
  nombre      String            @unique
  descripcion String?
  precioBase  Decimal
  estado      Boolean           @default(true)
  reservas    ReservaServicio[]

  @@map("servicios")
}

// Tabla de unión: Qué servicios extra compró un cliente en su reserva
model ReservaServicio {
  id             Int      @id @default(autoincrement())
  reservaId      Int
  reserva        Reserva  @relation(fields: [reservaId], references: [id])
  servicioId     Int
  servicio       Servicio @relation(fields: [servicioId], references: [id])
  cantidad       Int
  precioUnitario Decimal
  subtotal       Decimal
  fecha          DateTime @default(now()) // Fecha en que se añadió el servicio

  @@map("reservas_servicios")
}

model Factura {
  id            Int           @id @default(autoincrement())
  reservaId     Int           @unique
  reserva       Reserva       @relation(fields: [reservaId], references: [id])
  metodoPagoId  Int
  metodoPago    MetodoPago    @relation(fields: [metodoPagoId], references: [id])
  numeroFactura String        @unique
  fechaEmision  DateTime      @default(now())
  subtotal      Decimal
  impuestos     Decimal
  total         Decimal
  estado        EstadoFactura

  @@map("facturas")
}

model MetodoPago {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique // Efectivo, Tarjeta, Transferencia
  notas    String?
  facturas Factura[]

  @@map("metodos_pago")
}

// ------------------------------------
// COMUNICACIÓN Y AUDITORÍA
// ------------------------------------
model Consulta {
  id           Int            @id @default(autoincrement())
  nombre       String
  email        String
  asunto       String
  mensaje      String
  estado       EstadoConsulta @default(Pendiente)
  creadaEn     DateTime       @default(now())
  respondidaEn DateTime?
  respuesta    String?
  operadorId   String?
  operador     Usuario?       @relation(fields: [operadorId], references: [id])
  emailVinculado Email?

  @@map("consultas")
}

// Opcional pero recomendado para Promoción (auditoría de habitaciones)
model HabitacionEvento {
  id            Int                  @id @default(autoincrement())
  habitacionId  Int
  habitacion    Habitacion           @relation(fields: [habitacionId], references: [id])
  adminId       String?
  administrador Usuario?             @relation(fields: [adminId], references: [id])
  tipo          TipoEventoHabitacion
  detalle       String?
  fecha         DateTime             @default(now())

  @@map("habitaciones_eventos")
}

enum TipoBloqueo {
  Mantenimiento
  FueraDeServicio
  BloqueoOperativo
}

model HabitacionBloqueo {
  id           Int        @id @default(autoincrement())
  habitacionId Int
  habitacion   Habitacion @relation(fields: [habitacionId], references: [id])

  // Rango — sugerido: 'hasta' EXCLUSIVO
  desde DateTime
  hasta DateTime

  motivo String?
  tipo   TipoBloqueo @default(Mantenimiento)

  creadoPorId String?
  // 👇 nombramos la relación y usamos el lado opuesto de Usuario
  creadoPor   Usuario? @relation("UsuarioCreadorBloqueos", fields: [creadoPorId], references: [id])
  creadoEn    DateTime @default(now())

  @@index([habitacionId, desde])
  @@index([habitacionId, desde, hasta])
  @@map("habitaciones_bloqueos")
}


model ReservaMovimiento {
  id           Int            @id @default(autoincrement())

  // relación con Reserva
  reservaId    Int
  reserva      Reserva        @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  // cambios de estado
  estadoAnt    EstadoReserva
  estadoNuevo  EstadoReserva

  // auditoría
  cambiadoEn   DateTime       @default(now())

  // opcional: quién hizo el cambio (lo podés completar más adelante)
  operadorId   String?

  @@index([reservaId])
  @@map("reservas_movimientos")
}

// ------------------------------------
// SISTEMA DE EMAILS (IMAP/SMTP)
// ------------------------------------

enum EstadoEmail {
  NoLeido
  Leido
  Respondido
  Archivado
  Spam
}

enum PrioridadEmail {
  Alta
  Media
  Baja
}

enum CanalEmail {
  Email      // Gmail via IMAP/SMTP
  Web        // Formulario web (Consulta)
  WhatsApp   // Futuro
}

// Email principal recibido desde Gmail
model Email {
  id             Int               @id @default(autoincrement())
  
  // IDs de Gmail para sincronización
  messageId      String            @unique // Message-ID del header
  gmailId        String?           @unique // ID interno de Gmail (si usas API)
  threadId       String?           // Thread ID de Gmail para conversaciones
  
  // Remitente
  deNombre       String?
  deEmail        String
  
  // Destinatarios
  paraNombres    String?
  paraEmails     String            // Comma-separated si hay varios
  cc             String?
  bcc            String?
  
  // Contenido
  asunto         String
  cuerpoTexto    String?           @db.Text
  cuerpoHtml     String?           @db.Text
  
  // Metadata
  canal          CanalEmail        @default(Email)
  prioridad      PrioridadEmail    @default(Media)
  estado         EstadoEmail       @default(NoLeido)
  
  // Fechas
  fechaRecibido  DateTime          // Del header Date
  fechaSincronizado DateTime       @default(now())
  fechaLeido     DateTime?
  
  // Relaciones
  adjuntos       EmailAdjunto[]
  respuestas     EmailRespuesta[]
  
  // Operador asignado/que responde
  operadorId     String?
  operador       Usuario?          @relation(fields: [operadorId], references: [id])
  
  // Vinculación opcional con consulta web (si se migra)
  consultaId     Int?              @unique
  consulta       Consulta?         @relation(fields: [consultaId], references: [id])
  
  // Banderas útiles
  esSpam         Boolean           @default(false)
  tieneAdjuntos  Boolean           @default(false)
  
  @@index([deEmail])
  @@index([threadId])
  @@index([estado, prioridad])
  @@index([fechaRecibido])
  @@map("emails")
}

// Adjuntos de emails
model EmailAdjunto {
  id          Int      @id @default(autoincrement())
  emailId     Int
  email       Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  
  nombreArchivo String
  mimeType      String
  tamano        Int    // bytes
  
  // Almacenamiento (elegir uno)
  rutaLocal     String? // Si guardás en disco
  urlS3         String? // Si guardás en S3/cloud
  dataBase64    String? @db.Text // Si guardás en DB (no recomendado para archivos grandes)
  
  creadoEn      DateTime @default(now())
  
  @@index([emailId])
  @@map("emails_adjuntos")
}

// Respuestas enviadas (historial)
model EmailRespuesta {
  id              Int      @id @default(autoincrement())
  emailId         Int
  email           Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  
  // Quién respondió (opcional)
  operadorId      String?
  operador        Usuario?  @relation(fields: [operadorId], references: [id])
  
  // Contenido de la respuesta
  asunto          String
  cuerpoTexto     String?  @db.Text
  cuerpoHtml      String?  @db.Text
  
  // Metadata de envío
  messageIdRespuesta String? @unique // Message-ID de la respuesta enviada
  estadoEnvio        String   @default("Enviado") // Enviado, Error, etc.
  errorEnvio         String?  @db.Text
  
  // Fechas
  fechaEnviado    DateTime @default(now())
  
  @@index([emailId])
  @@index([operadorId])
  @@map("emails_respuestas")
}
